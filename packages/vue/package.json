{
  "name": "vfx-ui-vue",
  "version": "0.1.1",
  "description": "Shader-native visual effect components for Vue 3. WebGPU via vgpu.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/vfx-ui-vue.js",
  "module": "./dist/vfx-ui-vue.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/vfx-ui-vue.js"
    },
    "./compat": {
      "types": "./dist/types/vueCompat.d.ts",
      "import": "./dist/compat.js"
    }
  },
  "scripts": {
    "build": "vue-tsc -p tsconfig.json --noEmit && vite build && vue-tsc -p tsconfig.build.json && node scripts/prepare-declarations.mjs",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@webgpu/types": "^0.1.69",
    "cobe": "^2.0.1",
    "vgpu": "0.3.1"
  },
  "peerDependencies": {
    "vue": ">=3.5"
  },
  "devDependencies": {
    "@vfx-ui-vue/core": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.1.1",
    "jsdom": "^30.0.1",
    "@vue/server-renderer": "^3.5.21",
    "typescript": "^5.7.3",
    "vite": "^7.1.7",
    "vue": "^3.5.21",
    "vue-tsc": "^3.0.8",
    "vitest": "^2.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AliYa-chen/vfx-ui-vue.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/AliYa-chen/vfx-ui-vue/issues"
  },
  "homepage": "https://vfx.2t.hk",
  "keywords": [
    "vue",
    "webgpu",
    "shader",
    "wgsl",
    "vgpu",
    "visual-effects",
    "hero-section",
    "gpu",
    "animation"
  ]
}

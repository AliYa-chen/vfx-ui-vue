{
  "name": "@vfx-ui-vue/core",
  "version": "0.1.1",
  "description": "Renderer core for vfx-ui-vue: vgpu-backed WebGPU effect renderer with deterministic test support.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/core.js",
  "module": "./dist/core.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/core.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build && tsc -p tsconfig.build.json && node scripts/prepare-declarations.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@webgpu/types": "^0.1.69",
    "vgpu": "0.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3",
    "vite": "^7.1.7",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AliYa-chen/vfx-ui-vue.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/AliYa-chen/vfx-ui-vue/issues"
  },
  "homepage": "https://vfx.2t.hk",
  "keywords": [
    "webgpu",
    "shader",
    "wgsl",
    "vgpu",
    "renderer",
    "gpu"
  ]
}
